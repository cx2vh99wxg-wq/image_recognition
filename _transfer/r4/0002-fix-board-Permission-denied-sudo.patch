+            uint64_t dt_us = now - last_stat_us;
+            last_stat_us = now;
+
+            udp_recv_stats_t st;
+            memset(&st, 0, sizeof(st));
+            udp_receiver_stats(recv, &st);
+
+            /* 消费速率 = 窗口内取出的包数 / 窗口时长。
