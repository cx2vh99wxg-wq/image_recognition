+// 全局变量
+static volatile int g_running = 1;
+static DisplayControlSharedMemory* display_control_shm = NULL;
+static EmergencyBrakeSharedMemory* emergency_brake_shm = NULL;
+static WheelPosition wheel_position = WHEEL_NEUTRAL;
