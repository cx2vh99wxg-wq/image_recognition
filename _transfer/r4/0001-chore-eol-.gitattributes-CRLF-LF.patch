-    
-    // 用于统计每个数据值的出现次数 (0-255)
-    // 这样可以过滤掉偶发的错误读取值，提高可靠性
-    int data_count[256] = {0};
-    int successful_reads = 0;
-    
-
-    
-    // 进行多次读取尝试，以提高数据可靠性
-    for (retry_count = 0; retry_count < READ_RETRY_COUNT; retry_count++)
