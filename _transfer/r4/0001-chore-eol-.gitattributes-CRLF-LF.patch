+#define WRITE_RETRY_COUNT 15    // 写入重试次数
+#define READ_RETRY_COUNT 10     // 读取重试次数
+
+typedef enum
+{
+    SPI_MODE_SINGLE = 1,
+    SPI_MODE_DUAL,
+    SPI_MODE_QUAD
+} SpiTransferMode;
+
+typedef struct
+{
+    char device[MAX_DEVICE_PATH];
+    uint32_t speed_hz;
