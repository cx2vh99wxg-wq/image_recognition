+#define TIME_LEFT_TO_NEUTRAL   400000   // 左→中间 (0.4秒)
+#define TIME_RIGHT_TO_NEUTRAL  400000   // 右→中间 (0.4秒)
+#define TIME_LEFT_TO_RIGHT     1500000  // 左→右 (1.5秒)
