             LOGI("  丢块[校验=%u 重复=%u 无帧头=%u 旧帧=%u 异常=%u 帧头失败=%u] "
                  "内核[rcvbuf=%d 队列溢出=%llu InErrors=%llu]\n",
                  reass.stat_drop_checksum, reass.stat_drop_dup, reass.stat_drop_nohdr,
