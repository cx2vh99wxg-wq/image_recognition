+#    这条通路始终可见、可验证。判据与 start_m.sh 保持一致（看 /dev/pango_pci_driver）。
 ARGS=(--model "$MODEL")
 [ "$NO_LCD" = 1 ] && ARGS+=(--no-lcd)
 
+LOCAL_STUB=0
