+fi
+if [ "$LOCAL_STUB" = 1 ]; then
+    echo "[3b] 未检测到 /dev/pango_pci_driver → 本地图用合成拼接图案（模拟本板 3 路摄像头经 FPGA 2×2 拼接）"
