-nohup "$BIN_DIR/udp_m_send_main" "${SEND_ARGS[@]}" \
+nohup "$SEND_BIN" "${SEND_ARGS[@]}" \
     > "$REPO_ROOT/udp_send.log" 2>&1 &
 
