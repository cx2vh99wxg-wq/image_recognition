`timescale 1ns/1ps
module compare_rom;
    reg clk = 0;
    always #5 clk = ~clk;
    reg [7:0] pixel = 0;
    wire [72:0][7:0] old_curves, new_curves;
    @CURVE_INSTANCES@

    reg rst_n = 0;
    reg [8:0] table_index = 0;
    reg index_test = 1;
    wire old_done, new_done, old_scl, new_scl, old_clock, new_clock;
    tri1 old_sda, new_sda;
    wire [8:0] old_index, new_index;
    reg_config_old old_camera (
        .clk_25M(clk), .camera_rstn(rst_n), .initial_en(1'b1),
        .cmos_h_pixel(13'd640), .cmos_v_pixel(13'd480),
        .total_h_pixel(13'd1896), .total_v_pixel(13'd984), .rate(8'd0),
        .y_addr_st(13'd0), .y_addr_end(13'd0),
        .reg_conf_done(old_done), .i2c_sclk(old_scl), .i2c_sdat(old_sda),
        .clock_20k(old_clock), .reg_index(old_index)
    );
    reg_config new_camera (
        .clk_25M(clk), .camera_rstn(rst_n), .initial_en(1'b1),
        .cmos_h_pixel(13'd640), .cmos_v_pixel(13'd480),
        .total_h_pixel(13'd1896), .total_v_pixel(13'd984), .rate(8'd0),
        .y_addr_st(13'd0), .y_addr_end(13'd0),
        .reg_conf_done(new_done), .i2c_sclk(new_scl), .i2c_sdat(new_sda),
        .clock_20k(new_clock), .reg_index(new_index)
    );

    initial begin
        for (int i = 0; i < 512; i++) begin
            @(negedge clk);
            pixel = i[7:0];
            table_index = i[8:0];
            force old_camera.reg_index = table_index;
            force new_camera.reg_index = table_index;
            @(posedge clk);
            #1;
            if (old_curves !== new_curves)
                $fatal(1, "Gamma mismatch for pixel %0d", pixel);
            if (old_camera.reg_data !== new_camera.reg_data)
                $fatal(1, "SCCB ROM mismatch at %0d: %h != %h",
                       table_index, old_camera.reg_data, new_camera.reg_data);
        end
        @(negedge clk);
        release old_camera.reg_index;
        release new_camera.reg_index;
        force old_camera.clock_20k = clk;
        force new_camera.clock_20k = clk;
        repeat (5) @(negedge clk);
        rst_n = 1;
        index_test = 0;
        repeat (40000) @(negedge clk);
        if (!(old_done && new_done))
            $fatal(1, "SCCB initialization did not reach the last register");
        $display("PASS 73 Gamma curves, 512 SCCB indices, and complete SCCB stream");
        $finish;
    end

    always @(posedge clk or negedge clk) begin
        #1;
        if (!index_test &&
            {old_done, old_scl, old_sda, old_index, old_camera.i2c_data} !==
            {new_done, new_scl, new_sda, new_index, new_camera.i2c_data})
            $fatal(1, "SCCB stream mismatch at %0t", $time);
    end
endmodule
