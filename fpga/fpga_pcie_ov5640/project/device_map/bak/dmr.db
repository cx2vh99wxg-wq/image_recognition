                <row>
                    <data>create_generated_clock -name {ddrphy_sysclk} -source [get_ports {free_clk}] [get_pins {I_ips_ddr_top.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {84} -divide_by {16}</data>
