                </row>
                <row>
                    <data>set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold</data>
                </row>
                <row>
                    <data>set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold</data>
                </row>
                <row>
                    <data>set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold</data>
                </row>
                <row>
                    <data>set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]</data>
                </row>
                <row>
                    <data>set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]</data>
                </row>
            </table>
        </table_container>
        <table_container>
            <table id="device_map_timing_constraint" title="Inferred clocks commands" column_number="1">
                <column_headers>
                    <data>Command</data>
                </column_headers>
                <row>
                    <data>create_generated_clock -name {ref_clk|the_instance_name/u_gpll/CLKOUT0_Inferred} -master_clock {ref_clk} -source [get_ports {free_clk}] -edges {1 2 3} -edge_shift {0.000000 -10.000000 -20.000000} [get_pins {the_instance_name/u_gpll.CLKOUT0}] -add</data>
                </row>
                <row>
                    <data>create_generated_clock -name {ref_clk|u_fspi_slave_top/clk_gen_inst/u_gpll/CLKOUT0_Inferred} -master_clock {ref_clk} -source [get_ports {free_clk}] -edges {1 2 3} -edge_shift {0.000000 -18.750000 -37.500000} [get_pins {u_fspi_slave_top/clk_gen_inst/u_gpll.CLKOUT0}] -add</data>
                </row>
                <row>
                    <data>create_clock -period {1000} -waveform {0 500} -name {image_pcie_capture|spi_clk} [get_ports {spi_clk}] -add</data>
                </row>
                <row>
                    <data>set_clock_groups -name {Inferred_clock_group_0} -asynchronous -group [get_clocks {image_pcie_capture|spi_clk}]</data>
                </row>
            </table>
        </table_container>
    </general_container>
